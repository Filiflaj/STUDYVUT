{
  "name": "studyvut",
  "private": true,
  "version": "0.2.2",
  "description": "Desktop study app: study texts and quizzes for every subject",
  "license": "MIT",
  "author": "Filiflaj",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "tauri": "tauri",
    "content:check": "cargo run -q -p studyvut-cli -- check",
    "check:version": "node scripts/check-version.mjs",
    "release": "node scripts/release.mjs",
    "test:scripts": "node --test scripts/release.test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "katex": "^0.19.1",
    "marked": "18.2.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.6",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^26.6.6",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
